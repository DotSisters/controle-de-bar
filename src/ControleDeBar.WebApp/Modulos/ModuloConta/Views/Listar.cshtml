@using ControleDeBar.Dominio.Modulos.ModuloConta
@model List<ListarContasViewModel>

@{
  Layout = "_LayoutCrud";
  ViewBag.Titulo = "Contas";
  ViewBag.Info = "Cadastre, visualize e gerencie as contas do bar.";
  ViewBag.TextoBotao = "Cadastrar Conta";
  ViewBag.ControllerBotao = "Conta";
  ViewBag.ActionBotao = "Cadastrar";
}

<div class="listar-conteudo">
  @if (TempData["MensagemErro"] is string mensagemErro)
  {
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
      @mensagemErro
    </div>
  }

  @if (TempData["MensagemSucesso"] is string mensagemSucesso)
  {
    <div class="alert alert-success border-start border-success border-4 rounded-3" role="alert">
      @mensagemSucesso
    </div>
  }

  @if (Model.Count == 0)
  {
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
      Nenhuma conta cadastrada. Clique no botão acima para abrir a primeira conta.
    </div>
  }
  else
  {
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-2">
      @foreach (ListarContasViewModel conta in Model)
      {
        <div class="col">
          <div class="card h-100 shadow-sm d-flex flex-row overflow-hidden">
            <div class="card-accent-mint" aria-hidden="true"></div>
            <div class="d-flex flex-column flex-grow-1">
              <div class="card-header bg-light border-bottom">
                <div class="d-flex justify-content-between align-items-center gap-2">
                  <h5 class="card-title fw-semibold text-dark mb-0">@conta.NomeCliente</h5>
                  @if (conta.Situacao == SituacaoConta.Aberta)
                  {
                    <span class="badge text-bg-success rounded-pill">Aberta</span>
                  }
                  else
                  {
                    <span class="badge text-bg-secondary rounded-pill">Fechada</span>
                  }
                </div>
                @if (!string.IsNullOrWhiteSpace(conta.TempoDesdeUltimoPedido))
                {
                  <p class="fs-6 fw-medium mb-0 mt-2 text-body-secondary">
                    último pedido realizado @conta.TempoDesdeUltimoPedido
                  </p>
                }
              </div>
              <div class="card-body d-flex flex-column">
                <dl class="row g-2 mb-4">
                  <dt class="col-6 text-body-secondary fw-bold small">Mesa:</dt>
                  <dd class="col-6 mb-0">
                    <i class="bi bi-grid-3x3-gap-fill text-primary"></i> @conta.IdentificacaoMesa
                  </dd>

                  <dt class="col-6 text-body-secondary fw-bold small">Garçom:</dt>
                  <dd class="col-6 mb-0">
                    <i class="bi bi-person-badge-fill text-primary"></i> @conta.NomeGarcom
                  </dd>

                  <dt class="col-6 text-body-secondary fw-bold small">Abertura:</dt>
                  <dd class="col-6 mb-0">
                    <i class="bi bi-calendar-event-fill text-primary"></i>
                    @conta.DataAbertura.ToString("dd/MM/yyyy HH:mm")
                  </dd>

                  <dt class="col-6 text-body-secondary fw-bold small">Total:</dt>
                  <dd class="col-6 mb-0">
                    <i class="bi bi-wallet-fill text-primary"></i> R$ @conta.ValorTotal.ToString("F2")
                  </dd>
                </dl>

                <div class="d-flex flex-wrap gap-2 mt-auto">
                  @if (conta.Situacao == SituacaoConta.Aberta)
                  {
                    <a asp-action="Gerenciar" asp-route-id="@conta.Id" class="btn btn-sm btn-primary" title="Fechar conta">
                      <i class="bi bi-receipt"></i> Fechar Conta
                    </a>
                  }
                  else
                  {
                    <a asp-action="Gerenciar" asp-route-id="@conta.Id" class="btn btn-sm btn-primary" title="Ver detalhes">
                      <i class="bi bi-receipt"></i> Ver Detalhes
                    </a>
                  }

                  @if (conta.Situacao == SituacaoConta.Aberta)
                  {
                    <a asp-action="AdicionarPedidos" asp-route-id="@conta.Id" class="btn btn-sm btn-outline-primary"
                      title="Adicionar pedidos">
                      <i class="bi bi-plus-circle"></i> Adicionar Pedidos
                    </a>
                    <a asp-action="Editar" asp-route-id="@conta.Id" class="btn btn-sm btn-success" title="Editar conta">
                      <i class="bi bi-pencil-square"></i> Editar
                    </a>
                  }

                  <a asp-action="Excluir" asp-route-id="@conta.Id" class="btn btn-sm btn-danger" title="Excluir conta">
                    <i class="bi bi-trash"></i> Excluir
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      }
    </div>
  }
</div>

<style>
  .card-header {
    padding: 0.75rem 1rem;
  }

  .card {
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
  }
</style>
