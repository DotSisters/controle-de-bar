@{
Layout = "_LayoutCrud";
ViewBag.Titulo = "📋 Cadastrar Conta";
@* ViewBag.Icone = "bi-plus-square-fill"; *@
ViewBag.Info = "Registre as informações da nova conta.";
}

@model CadastrarContaViewModel;

<form asp-action="Cadastrar" method="post">

    <div class="mb-3">
        <label asp-for="NomeCliente" class="form-label fw-semibold text-primary text-uppercase small">Nome do
            Cliente</label>
        <input asp-for="NomeCliente" type="text" class="form-control" />
        <span asp-validation-for="NomeCliente" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MesaId" class="form-label fw-semibold text-primary text-uppercase small">Mesa</label>
        <select asp-for="MesaId" asp-items="Model.Mesas" class="form-select">
            <option value="">Selecione uma mesa</option>
        </select>
        <span asp-validation-for="MesaId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GarcomId" class="form-label fw-semibold text-primary text-uppercase small">Garçom</label>
        <select asp-for="GarcomId" asp-items="Model.Garcons" class="form-select">
            <option value="">Selecione um garçom</option>
        </select>
        <span asp-validation-for="GarcomId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary rounded-2 px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-2 px-4" type="submit">Confirmar</button>
    </div>
</form>
