@using ControleDeBar.Dominio.Modulos.ModuloConta
@model AdicionarPedidosContaViewModel
@{
Layout = "_LayoutCrud";
ViewBag.Titulo = "➕ Adicionar Pedidos";
ViewBag.Info = "Visualize e adicione pedidos vinculados à conta selecionada.";
}

<div class="listar-conteudo">
    @if (TempData["MensagemErro"] is string mensagemErro)
    {
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @mensagemErro
    </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0 fw-semibold">Conta em atendimento</h5>
        </div>
        <div class="card-body">
            <dl class="row g-2 mb-0">
                <dt class="col-sm-4 text-body-secondary fw-bold small">Cliente</dt>
                <dd class="col-sm-8 mb-0">@Model.NomeCliente</dd>

                <dt class="col-sm-4 text-body-secondary fw-bold small">Mesa</dt>
                <dd class="col-sm-8 mb-0">@Model.IdentificacaoMesa</dd>

                <dt class="col-sm-4 text-body-secondary fw-bold small">Garçom</dt>
                <dd class="col-sm-8 mb-0">@Model.NomeGarcom</dd>

                <dt class="col-sm-4 text-body-secondary fw-bold small">Situação</dt>
                <dd class="col-sm-8 mb-0">@(Model.Situacao == SituacaoConta.Aberta ? "Aberta" : "Fechada")</dd>

                <dt class="col-sm-4 text-body-secondary fw-bold small">Valor Total</dt>
                <dd class="col-sm-8 mb-0 fw-semibold">R$ @Model.ValorTotal.ToString("F2")</dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0 fw-semibold">Adicionar pedido</h5>
        </div>
        <div class="card-body">
            @if (Model.Situacao == SituacaoConta.Fechada)
            {
            <div class="alert alert-warning border-start border-warning border-4 rounded-3 mb-0" role="alert">
                Não é possível adicionar pedidos a uma conta fechada.
            </div>
            }
            else
            {
            <form asp-action="AdicionarPedido" method="post">
                <input type="hidden" asp-for="ContaId" />
                <input type="hidden" asp-for="NomeCliente" />
                <input type="hidden" asp-for="IdentificacaoMesa" />
                <input type="hidden" asp-for="NomeGarcom" />
                <input type="hidden" asp-for="Situacao" />
                <input type="hidden" asp-for="ValorTotal" />

                <div class="mb-3">
                    <label asp-for="ProdutoId" class="form-label fw-semibold text-primary text-uppercase small">Produto</label>
                    <select asp-for="ProdutoId" asp-items="Model.Produtos" class="form-select">
                        <option value="">Selecione um produto</option>
                    </select>
                    <span asp-validation-for="ProdutoId" class="text-danger small fw-semibold"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantidade"
                        class="form-label fw-semibold text-primary text-uppercase small">Quantidade</label>
                    <input asp-for="Quantidade" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Quantidade" class="text-danger small fw-semibold"></span>
                </div>

                <button class="btn btn-primary rounded-2 px-4" type="submit">Adicionar Pedido</button>
            </form>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0 fw-semibold">Pedidos atuais</h5>
        </div>
        <div class="card-body">
            @if (Model.Pedidos.Count == 0)
            {
            <div class="alert alert-primary border-start border-primary border-4 rounded-3 mb-0" role="alert">
                Nenhum pedido cadastrado nesta conta.
            </div>
            }
            else
            {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Quantidade</th>
                            <th>Valor unitário</th>
                            <th>Total do item</th>
                            @if (Model.Situacao == SituacaoConta.Aberta)
                            {
                            <th>Ações</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (PedidoContaViewModel pedido in Model.Pedidos)
                        {
                        <tr>
                            <td>@pedido.NomeProduto</td>
                            <td>@pedido.Quantidade</td>
                            <td>R$ @pedido.ValorUnitario.ToString("F2")</td>
                            <td>R$ @pedido.ValorTotal.ToString("F2")</td>
                            @if (Model.Situacao == SituacaoConta.Aberta)
                            {
                            <td>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <form asp-action="AlterarQuantidadeItemPedido" method="post" class="d-flex align-items-center gap-2">
                                        <input type="hidden" name="contaId" value="@Model.ContaId" />
                                        <input type="hidden" name="itemPedidoId" value="@pedido.Id" />
                                        <input type="number" name="quantidade" value="@pedido.Quantidade" min="1"
                                            class="form-control form-control-sm" style="max-width: 5.5rem;" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit" title="Alterar quantidade">
                                            Alterar
                                        </button>
                                    </form>
                                    <form asp-action="RemoverItemPedido" method="post">
                                        <input type="hidden" name="contaId" value="@Model.ContaId" />
                                        <input type="hidden" name="itemPedidoId" value="@pedido.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Remover item">
                                            Remover
                                        </button>
                                    </form>
                                </div>
                            </td>
                            }
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary rounded-2 px-4" asp-action="Gerenciar" asp-route-id="@Model.ContaId">Voltar</a>
    </div>
</div>
