@model List<ListarGarconsViewModel>

@{
  Layout = "_LayoutCrud";
  ViewBag.Titulo = "Garçons";
  ViewBag.Info = "Cadastre, visualize e gerencie os garçons do bar.";
  ViewBag.TextoBotao = "Cadastrar Garçom";
  ViewBag.ControllerBotao = "Garcom";
  ViewBag.ActionBotao = "Cadastrar";
}

<div class="listar-conteudo">
  @if (TempData["MensagemErro"] is string mensagemErro)
  {
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
      @mensagemErro
    </div>
  }

  @if (TempData["MensagemSucesso"] is string mensagemSucesso)
  {
    <div class="alert alert-success border-start border-success border-4 rounded-3" role="alert">
      @mensagemSucesso
    </div>
  }

  @if (Model.Count == 0)
  {
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
      Nenhum garçom cadastrado. Clique no botão acima para criar o primeiro garçom.
    </div>
  }
  else
  {
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-2">
      @foreach (ListarGarconsViewModel garcom in Model)
      {
        <div class="col">
          <div class="card h-100 shadow-sm d-flex flex-row overflow-hidden">
            <div class="card-accent-mint" aria-hidden="true"></div>
            <div class="d-flex flex-column flex-grow-1">
              <div class="card-header bg-light border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                  <h5 class="card-title fw-semibold text-dark mb-0">@garcom.Nome</h5>
                  @* <span class="badge text-bg-primary rounded-pill">@garcom.Id.ToString().Substring(0, 7)</span> *@
                </div>
              </div>
              <div class="card-body d-flex flex-column">
                <dl class="row g-2 mb-4">
                  <dt class="col-6 text-body-secondary fw-bold small">Telefone:</dt>
                  <dd class="col-6 mb-0">
                    <i class="bi bi-telephone-fill text-primary"></i> @garcom.Telefone
                  </dd>

                  <dt class="col-6 text-body-secondary fw-bold small">CPF:</dt>
                  <dd class="col-6 mb-0">
                    <i class="bi bi-person-vcard-fill text-primary"></i> @garcom.Cpf
                  </dd>

                  <dt class="col-6 text-body-secondary fw-bold small mt-2">ID:</dt>
                  <dd class="col-6 mb-0 text-break font-monospace small text-muted">
                    @garcom.Id.ToString().Substring(0, 7)</dd>
                  </dl>

                  <div class="d-flex flex-wrap gap-2 mt-auto justify-content-start">
                    <a asp-action="Editar" asp-route-id="@garcom.Id" class="btn btn-sm btn-success" title="Editar garçom">
                      <i class="bi bi-pencil-square"></i> Editar
                    </a>
                    <a asp-action="Excluir" asp-route-id="@garcom.Id" class="btn btn-sm btn-danger" title="Excluir garçom">
                      <i class="bi bi-trash"></i> Excluir
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        }
      </div>
    }
  </div>

  <style>
    .card-header {
      padding: 0.75rem 1rem;
    }

    .card {
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
  </style>
