@{
Layout = "_LayoutCrud";
ViewBag.Titulo = "📝 Editar Garçom";
@* ViewBag.Icone = "bi-pencil-square"; *@
ViewBag.Info = "Atualize as informações do garçom selecionado.";
}

@model EditarGarcomViewModel;

<form asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefone" class="form-label">Telefone</label>
        <input asp-for="Telefone" type="tel" class="form-control" />
        <span asp-validation-for="Telefone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Cpf" class="form-label">CPF</label>
        <input asp-for="Cpf" type="text" class="form-control" />
        <span asp-validation-for="Cpf" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary rounded-2 px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-2 px-4" type="submit">Confirmar</button>
    </div>
</form>
