@{
Layout = "_Layout";
ViewData["BodyClass"] = "page-mint";
}

@model RegistrarViewModel

<section class="row hero hero-auth g-4 g-lg-5">
    <div class="col-lg-6 d-flex flex-column justify-content-start hero-copy">
        <h1 class="display-5 hero-title mb-3">Criar Conta</h1>
        <p class="hero-lead mb-4">
            Registre-se para começar a gerenciar seu bar com Controle de Bar. Acesso rápido e seguro.
        </p>

        <form class="card border shadow-sm p-4 w-100" asp-action="Registrar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
                <input asp-for="Nome" type="text" class="form-control" autofocus>
                <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold text-primary text-uppercase small">E-mail</label>
                <input asp-for="Email" type="email" class="form-control">
                <span asp-validation-for="Email" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Senha" class="form-label fw-semibold text-primary text-uppercase small">Senha</label>
                <input asp-for="Senha" type="password" class="form-control">
                <span asp-validation-for="Senha" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmarSenha"
                    class="form-label fw-semibold text-primary text-uppercase small">Confirmar Senha</label>
                <input asp-for="ConfirmarSenha" type="password" class="form-control">
                <span asp-validation-for="ConfirmarSenha" class="text-danger small fw-semibold"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <span class="text-muted small">
                    Já tem conta? <a asp-action="Entrar" class="text-primary text-decoration-none fw-semibold">Fazer
                        Login</a>
                </span>
                <button class="btn btn-primary px-4" type="submit">Registrar</button>
            </div>
        </form>
    </div>

    <div class="col-lg-6 hero-visual">
        <img src="~/img/bar.png" alt="Ilustração de Controle de Bar" class="hero-img" />
    </div>
</section>