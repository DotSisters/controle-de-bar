@{
  Layout = "_Layout";
  ViewData["BodyClass"] = "page-mint";
}

@model EntrarViewModel

<section class="row hero hero-auth g-4 g-lg-5">
  <div class="col-lg-6 d-flex flex-column justify-content-start hero-copy">
    <h1 class="display-5 hero-title mb-3">Entrar</h1>
    <p class="hero-lead mb-4">
      Acesse sua conta para continuar gerenciando seu bar.
    </p>

    <form class="card border shadow-sm p-4 w-100 gap-4 mt-2" asp-action="Entrar" method="post">
      <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

      <input type="hidden" asp-for="ReturnUrl">

      <div class="mb-4">
        <label asp-for="Email" class="form-label fw-semibold text-primary text-uppercase fs-6">E-mail</label>
        <input asp-for="Email" type="email" class="form-control" autofocus>
        <span asp-validation-for="Email" class="text-danger fs-6 fw-semibold"></span>
      </div>

      <div class="mb-4">
        <label asp-for="Senha" class="form-label fw-semibold text-primary text-uppercase fs-6">Senha</label>
        <input asp-for="Senha" type="password" class="form-control">
        <span asp-validation-for="Senha" class="text-danger fs-6 fw-semibold"></span>
      </div>

      <div class="mb-4 form-check">
        <input asp-for="LembrarMe" type="checkbox" class="form-check-input">
        <label asp-for="LembrarMe" class="form-check-label fs-6 text-muted">Lembrar-me</label>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-4">
        <span class="text-muted small">
          Não tem conta? <a asp-action="Registrar" class="text-primary text-decoration-none fw-semibold">Criar
            Conta</a>
        </span>
        <button class="btn btn-primary px-4" type="submit">Entrar</button>
      </div>
    </form>
  </div>

  <div class="col-lg-6 hero-visual">
    <img src="~/img/entrar.png" alt="Ilustração de Controle de Bar" class="hero-img" />
  </div>
</section>
