@using ControleDeBar.Dominio.Modulos.ModuloMesa
@model List<ListarMesasViewModel>
    @{
    Layout = "_LayoutCrud";
    ViewBag.Titulo = "🍽️ Mesas";
    ViewBag.Info = "Cadastre, visualize e gerencie as mesas do bar.";
    ViewBag.TextoBotao = "Cadastrar Mesa";
    ViewBag.ControllerBotao = "Mesa";
    ViewBag.ActionBotao = "Cadastrar";
    }

    <div class="listar-conteudo">
        @if (TempData["MensagemErro"] is string mensagemErro)
        {
        <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
            @mensagemErro
        </div>
        }

        @if (TempData["MensagemSucesso"] is string mensagemSucesso)
        {
        <div class="alert alert-success border-start border-success border-4 rounded-3" role="alert">
            @mensagemSucesso
        </div>
        }

        @if (Model.Count == 0)
        {
        <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
            Nenhuma mesa cadastrada. Clique no botão acima para criar a primeira mesa.
        </div>
        }
        else
        {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (ListarMesasViewModel mesa in Model)
            {
            <div class="col">
                <div class="card h-100 shadow-sm d-flex flex-column overflow-hidden">
                    <div class="card-header bg-light border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title fw-semibold text-dark mb-0">Mesa @mesa.Identificacao</h5>
                            <span class="badge @(mesa.StatusMesa == StatusMesa.Livre ? " bg-success" : "bg-warning" )
                                rounded-pill">
                                @(mesa.StatusMesa == StatusMesa.Livre ? "Livre" : "Ocupada")
                            </span>
                        </div>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <dl class="row g-2 mb-4">
                            <dt class="col-6 text-body-secondary fw-bold small">Lugares:</dt>
                            <dd class="col-6 mb-0">
                                <i class="bi bi-people-fill text-primary"></i> @mesa.QuantidadeLugar
                            </dd>

                            <dt class="col-6 text-body-secondary fw-bold small">Status:</dt>
                            <dd class="col-6 mb-0">
                                @if (mesa.StatusMesa == StatusMesa.Livre)
                                {
                                <i class="bi bi-check-circle-fill text-success"></i>
                                <span class="text-success fw-semibold">Disponível</span>
                                }
                                else
                                {
                                <i class="bi bi-x-circle-fill text-warning"></i>
                                <span class="text-warning fw-semibold">Ocupada</span>
                                }
                            </dd>

                            <dt class="col-12 text-body-secondary fw-bold small mt-2">ID:</dt>
                            <dd class="col-12 mb-0 text-break font-monospace small text-muted">@mesa.Id</dd>
                        </dl>

                        <div class="d-flex flex-wrap gap-2 mt-auto justify-content-between">
                            <a asp-action="Editar" asp-route-id="@mesa.Id" class="btn btn-sm btn-success"
                                title="Editar mesa">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                            <a asp-action="Excluir" asp-route-id="@mesa.Id" class="btn btn-sm btn-danger"
                                title="Excluir mesa">
                                <i class="bi bi-trash"></i> Excluir
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            }
        </div>
        }
    </div>

    <style>
        .card-header {
            padding: 0.75rem 1rem;
        }

        .card {
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
    </style>