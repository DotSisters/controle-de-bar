@using ControleDeBar.Dominio.Modulos.ModuloMesa
@{
Layout = "_LayoutCrud";
ViewBag.Titulo = "📋 Cadastrar Mesa";
@* ViewBag.Icone = "bi-plus-square-fill"; *@
ViewBag.Info = "Registre as informações da nova mesa.";
}

@model CadastrarMesaViewModel;

<form asp-action="Cadastrar" method="post">

    <div class="mb-3">
        <label asp-for="Identificacao"
            class="form-label fw-semibold text-primary text-uppercase small">Identificação</label>
        <input asp-for="Identificacao" type="text" class="form-control" />
        <span asp-validation-for="Identificacao" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="QuantidadeLugar" class="form-label fw-semibold text-primary text-uppercase small">Quantidade de
            Lugares</label>
        <input asp-for="QuantidadeLugar" type="number" class="form-control" />
        <span asp-validation-for="QuantidadeLugar" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary rounded-2 px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-2 px-4" type="submit">Confirmar</button>
    </div>
</form>