@{
Layout = "_LayoutCrud";
ViewBag.Titulo = "🗑️ Excluir Mesa";
@* ViewBag.Icone = "bi-trash-fill"; *@
ViewBag.Info = "Confirme a exclusão desta mesa.";
}

@model ExcluirMesaViewModel;

<form asp-action="Excluir" asp-route-id="@Model.Id" method="post">
    <div class="alert alert-warning border-start border-primary border-1 rounded-3" role="alert">
        Deseja realmente excluir esta mesa?
    </div>

    <div class="mb-3">
        <label asp-for="Identificacao"
            class="form-label fw-semibold text-primary text-uppercase small">Identificação</label>
        <input asp-for="Identificacao" type="text" class="form-control" disabled />
    </div>

    <div class="mb-3">
        <label asp-for="QuantidadeLugar" class="form-label fw-semibold text-primary text-uppercase small">Quantidade de
            Lugares</label>
        <input asp-for="QuantidadeLugar" type="number" class="form-control" disabled />
    </div>

    <div class="mb-3">
        <label asp-for="StatusMesa" class="form-label fw-semibold text-primary text-uppercase small">Status</label>
        <input asp-for="StatusMesa" type="text" class="form-control" disabled />
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary rounded-2 px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-2 px-4" type="submit">Confirmar</button>
    </div>
</form>