@{
Layout = "_LayoutCrud";
ViewBag.Titulo = "📝 Editar Produto";
ViewBag.Info = "Atualize as informações do produto selecionado.";
}

@model EditarProdutoViewModel;

<form asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Valor" class="form-label">Valor</label>
        <input asp-for="Valor" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Valor" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary rounded-2 px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-2 px-4" type="submit">Confirmar</button>
    </div>
</form>